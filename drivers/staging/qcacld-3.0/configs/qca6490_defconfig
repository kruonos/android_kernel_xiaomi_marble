CONFIG_CNSS_QCA6490 := y

DEVNAME := qca6490

include $(WLAN_ROOT)/configs/default_defconfig

# CFR RX PPDU delivery uses DP WDI fanout; default_defconfig disables this
# when packet logging is removed, so enable it explicitly for qca6490.
CONFIG_WDI_EVENT_ENABLE := y

#Enable Constrained Application Protocol feature
CONFIG_WLAN_FEATURE_COAP := y
