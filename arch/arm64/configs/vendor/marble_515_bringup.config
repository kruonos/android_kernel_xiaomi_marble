# Compile bring-up only: merge after gki_defconfig and waipio_GKI.config.
# This is not a complete Marble runtime or packaging configuration.
CONFIG_LOCALVERSION="-marble-5.15-probe"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO_CLANG_THIN=y
CONFIG_DEBUG_FS=y
CONFIG_POWER_SUPPLY=y
CONFIG_NVMEM=y
CONFIG_QCOM_QFPROM=m
CONFIG_PINCTRL_CAPE=m
CONFIG_PHY_QCOM_UFS_V4=m
CONFIG_QCOM_TSENS=m
CONFIG_QTI_BCL_PMIC5=m
CONFIG_QTI_BCL_SOC_DRIVER=m
CONFIG_IPC_LOGGING=m
CONFIG_SCSI_UFS_CRYPTO_QTI=m
CONFIG_QTI_CRYPTO_COMMON=m
CONFIG_QTI_HW_KEY_MANAGER=m
CONFIG_MSM_TMECOM_QMP=m

# Retained downstream peripheral bindings and PMIC child providers.
CONFIG_SERIAL_MSM_GENI=m
CONFIG_SERIAL_QCOM_GENI_CONSOLE_ONLY=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE_DEFAULT_ENABLED=y
CONFIG_I2C_MSM_GENI=m
CONFIG_SPI_MSM_GENI=m
CONFIG_MSM_GPI_DMA=m
CONFIG_MFD_I2C_PMIC=m
CONFIG_REGULATOR_QCOM_PM8008=m
CONFIG_PINCTRL_QCOM_SPMI_PMIC=m
CONFIG_QCOM_SPMI_ADC5=m
CONFIG_QCOM_SPMI_TEMP_ALARM=m
